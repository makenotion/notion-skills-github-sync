# Secrets only — all non-secret configuration lives in config.json.
# See config.json.example for the full config structure.

# Notion connection token, used to read the Skills Public API. REQUIRED for
# `sync` (locally and in CI — there is no `ntn` keychain fallback). Needs read
# access to the skills you want published; that access IS the publish control.
# NOTION_API_TOKEN=ntn_xxx

# GitHub push token. If unset, the tool falls back to `gh auth token`.
# Needs push access to the target repo.
# GITHUB_TOKEN=ghp_xxx
