# --- Notion source ---
# Which ntn environment to use (local | dev | stg | prod). The Cowork Skills DB
# lives in the dev workspace.
NOTION_ENV=dev

# Notion database IDs are now configured in config.json (see config.json.example).
# The env vars below are only needed for CI environments where config.json isn't
# available. They serve as a fallback; config.json takes precedence if it exists.
#
# NOTION_DATA_SOURCE_ID=<data source id>
# NOTION_DATABASE_ID=<database id>
# NOTION_CHANGE_REQUESTS_DATA_SOURCE_ID=<change requests data source id>

# --- GitHub target ---
GITHUB_REPO=makenotion/epd-skills
# Branch to sync into. Use a test branch first; switch to main when ready.
GITHUB_BRANCH=notion-sync
# Optional. If unset, the tool falls back to `gh auth token`.
# GITHUB_TOKEN=ghp_xxx

# --- Behavior ---
# Where generated plugins live inside the repo.
PLUGINS_DIR=plugins
# Commit author shown on synced commits.
GIT_AUTHOR_NAME=notion-skills-sync
GIT_AUTHOR_EMAIL=notion-skills-sync@users.noreply.github.com
