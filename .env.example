# --- Notion source ---
# Which ntn environment to use (local | dev | stg | prod). The Cowork Skills DB
# lives in the dev workspace.
NOTION_ENV=dev
# Data source id of the skills database (NOT the database id). Find it with:
#   ntn --env dev api -X GET /v1/databases/<dbId> --notion-version 2025-09-03
NOTION_DATA_SOURCE_ID=37db35e6-e67f-8009-b4f2-000b10918252
# Database id — only needed by `setup` to add the Published property.
NOTION_DATABASE_ID=37db35e6e67f807b8dbad604dbe211ec
# Optional. Data source id of the "Change Requests" data source. When set, the
# injected updater skill offers to file a change request (a new page linked to the
# skill) for review instead of editing the skill directly. Omit to disable that option.
NOTION_CHANGE_REQUESTS_DATA_SOURCE_ID=37fb35e6-e67f-805b-8b83-000becf4406b

# --- GitHub target ---
GITHUB_REPO=makenotion/epd-skills
# Branch to sync into. Use a test branch first; switch to main when ready.
GITHUB_BRANCH=notion-sync
# Optional. If unset, the tool falls back to `gh auth token`.
# GITHUB_TOKEN=ghp_xxx

# --- Behavior ---
# Where generated plugins live inside the repo.
PLUGINS_DIR=plugins
# Commit author shown on synced commits.
GIT_AUTHOR_NAME=notion-skills-sync
GIT_AUTHOR_EMAIL=notion-skills-sync@users.noreply.github.com
