# All configuration for `sync`, secret and not. Copy to `.env` (gitignored).
#
# In CI the same names come from repo *variables* (non-secret) and *secrets*
# (the two tokens) — see .github/workflows/sync.yml. Nothing is committed, which
# is what keeps every team's copy of this repo identical and `update` painless.
#
# Migrating from a config.json? Run: bun run setup --migrate-config

# --- Secrets ----------------------------------------------------------------

# Notion connection token, used to read the Skills Public API. REQUIRED.
# Needs read access to the skills you want published; that access IS the publish
# control — there is no per-skill publish flag.
# NOTION_API_TOKEN=ntn_xxx

# GitHub push token, needs push access to the target repo. If unset, the tool
# falls back to `gh auth token` for local runs.
# GITHUB_TOKEN=ghp_xxx

# --- Where plugins are published --------------------------------------------

# The repo the sync writes to, as owner/name. REQUIRED.
# GITHUB_REPO=your-org/notion-skills
# Branch to write (default: main).
# GITHUB_BRANCH=main
# Commit identity.
# GIT_AUTHOR_NAME=notion-skills-sync
# GIT_AUTHOR_EMAIL=notion-skills-sync@users.noreply.github.com

# --- Which Notion ------------------------------------------------------------

# prod (default) | dev | stg | local. Flips the API host, the page links written
# into skill markers, and the injected updater's MCP endpoint together.
# NOTION_ENV=prod
# Override the API host outright (rarely needed).
# NOTION_BASE_URL=https://api.notion.com

# Recorded in each skill's .notion-sync.json and used by the injected updater's
# write-back guidance. Neither is needed to *read* skills.
# SKILLS_DATABASE_ID=
# SKILLS_DATA_SOURCE_ID=
# Set this to offer the updater's "propose a change for review" path.
# CHANGE_REQUESTS_DATA_SOURCE_ID=

# --- Layout ------------------------------------------------------------------

# Directory plugins are published under (default: plugins).
# PLUGINS_DIR=plugins
# Fallback directory name for a plugin the API reports with no name.
# PLUGIN_SLUG=skills
# Inject the notion-skill-updater plugin (default: true).
# INJECT_UPDATER=true
# UPDATER_SLUG=notion-skill-updater

# --- Updates -----------------------------------------------------------------

# Merge + push tool updates from `upstream` before each scheduled sync
# (default: true). See `bun run update` for the manual equivalent.
# AUTO_UPDATE=true
