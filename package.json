{
  "name": "notion-skills-github-sync",
  "version": "0.1.0",
  "description": "Sync skill pages from a Notion database into a GitHub plugin-marketplace repo for Claude Code, Cursor, and Codex.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "notion-skills-sync": "src/cli.ts"
  },
  "scripts": {
    "setup": "bun run src/cli.ts setup",
    "setup:web": "bun run src/cli.ts setup --web",
    "sync": "bun run src/cli.ts sync",
    "dry-run": "bun run src/cli.ts sync --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  }
}
